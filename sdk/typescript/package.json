{
  "name": "synthex-x402",
  "version": "1.0.0",
  "description": "Client SDK for Synthex Forge's paid x402 services (USDC on Base). One call: 402 -> EIP-3009 sign -> retry -> signed result.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mock": "npm run build && node dist/mock.js",
    "self-test": "npm run build && node dist/selftest.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "x402",
    "agents",
    "mcp",
    "usdc",
    "base",
    "payments",
    "signed",
    "verifiable"
  ],
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermeschoosenone-debug/synthex-x402.git"
  },
  "homepage": "https://x402.synthexforge.com/llms.txt"
}
